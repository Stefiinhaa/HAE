# Impede a execucao de scripts na pasta de uploads.
# Permite que imagens PNG, JPG, GIF, WEBP e AVIF sejam exibidas normalmente.

<FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp|html?|js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# SVG antigo (legado) continua aparecendo em <img>, mas isolado: sem scripts mesmo se aberto direto.
# O sistema atual nao aceita mais upload de SVG.
<FilesMatch "\.svg$">
    <IfModule mod_headers.c>
        Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
        Header set X-Content-Type-Options "nosniff"
    </IfModule>
</FilesMatch>
