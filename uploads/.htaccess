# Pasta de uploads: somente imagens estáticas. Nenhum script pode ser executado aqui.
Options -Indexes -ExecCGI

<FilesMatch "\.(php[0-9s]?|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp|html?|svg|js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
</IfModule>
